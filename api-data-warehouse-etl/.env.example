# ---------- Source API ----------
API_BASE_URL=https://fakestoreapi.com
API_TIMEOUT_SECONDS=15
API_MAX_RETRIES=4
API_BACKOFF_SECONDS=1.5

# ---------- PostgreSQL ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sales_dwh
POSTGRES_USER=etl_user
POSTGRES_PASSWORD=change_me
# Optional: full SQLAlchemy URL overrides the POSTGRES_* values above
# DATABASE_URL=postgresql+psycopg2://etl_user:change_me@localhost:5432/sales_dwh

# ---------- AWS S3 ----------
S3_ENABLED=false
S3_BUCKET=your-etl-bucket
S3_PREFIX=api-dwh
S3_SSE=AES256
# Leave empty for real AWS. Set for LocalStack/MinIO, e.g. http://localhost:4566
S3_ENDPOINT_URL=
S3_FAIL_ON_ERROR=false
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# ---------- Pipeline behaviour ----------
LOG_LEVEL=INFO
FULL_REFRESH=false
# Re-extract this many days before the watermark to catch late-arriving rows
LOOKBACK_DAYS=1
# Abort the load if more than this share of a dataset is rejected
MAX_REJECT_RATIO=0.30
FAIL_ON_QUALITY_ERROR=true
